{
  "name": "keychain-maker",
  "version": "0.1.0",
  "description": "Llaveros para impresión 3D desde un SVG o un texto, en el navegador: base, relieve, arandela y STL.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "figures": "python3 docs/assets/src/ilustraciones.py",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/olmedcr-cmyk/keychain-maker.git"
  },
  "homepage": "https://keychain-maker.olmedcr.workers.dev",
  "author": "Divina Machina by Qs Ventures"
}
